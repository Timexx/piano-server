# Piano Server - Production Configuration für Nginx Proxy Manager
# Location: /home/tim/piano/.env

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
PORT=3000
NODE_ENV=production

# =============================================================================
# PROXY CONFIGURATION (KRITISCH!)
# =============================================================================

# WICHTIG: Muss leer sein wenn Nginx /music → / mapped!
# Nginx entfernt bereits /music mit: proxy_pass http://IP:3000/
BASE_PATH=

# Trust Proxy - Verwende IP des Nginx Proxy Managers
# Oder 'loopback' wenn beide auf selber Maschine
TRUST_PROXY=192.168.10.8

# =============================================================================
# SECURITY
# =============================================================================
SESSION_SECURE=true