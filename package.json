{
  "name": "piano-sheets",
  "version": "3.0.0",
  "private": true,
  "description": "Server-side thumbnail generation for ultra-fast iPad performance",
  "scripts": {
    "start": "node server.js",
    "start:optimized": "./start-optimized.sh",
    "start:memory": "node --max-old-space-size=1024 --expose-gc server.js",
    "start:proxy": "TRUST_PROXY=true node server.js",
    "dev": "node --inspect server.js",
    "install:deps": "npm install pdfjs-dist@2.16.105 canvas@^2.11.2 sharp@^0.33.5",
    "migrate:data": "node scripts/migrate-data.js"
  },
  "dependencies": {
    "canvas": "^2.11.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.1",
    "express-rate-limit": "^7.1.5",
    "file-type": "^16.5.4",
    "helmet": "^8.1.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "2.16.105",
    "sharp": "^0.33.5"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "keywords": [
    "music",
    "pdf",
    "sheets",
    "piano",
    "mobile",
    "performance",
    "thumbnails"
  ]
}
